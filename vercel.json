{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 10,
      "memory": 1024,
      "includeFiles": "**/*.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/public/index.html"
    }
  ]
}